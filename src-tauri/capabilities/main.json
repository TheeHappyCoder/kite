{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window can check/install updates and read clipboard text for Paste actions.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:3100/*"
    ]
  },
  "permissions": [
    "allow-update",
    "clipboard-manager:allow-read-text"
  ]
}
