# Google OAuth 2.0 client (Web application) from Google Cloud Console.
# Authorized redirect URI: http://localhost:3100/api/auth/google/callback
# Enable the Gmail API for the project. Scopes used: gmail.modify, gmail.send.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft app registration (Entra ID, "Any Entra ID tenant + personal Microsoft accounts"),
# public client (mobile & desktop), no secret: sign-in uses PKCE.
# Redirect URI: http://localhost:3100/api/auth/microsoft/callback
# Scopes: offline_access User.Read Mail.ReadWrite Mail.Send.
MICROSOFT_CLIENT_ID=
