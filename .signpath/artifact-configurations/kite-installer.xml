<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "kite-installer": the GitHub artifact is a zip holding the NSIS installer
     (Kite_<version>_x64-setup.exe), signed with Authenticode. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Kite_*_x64-setup.exe" product-name="Kite">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
